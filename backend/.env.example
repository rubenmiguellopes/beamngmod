# Configuração do Provedor de IA
# Opção 1: OpenAI Oficial (GPT-4o, GPT-4o-mini, etc.)
OPENAI_API_KEY=sk-proj-SEU_TOKEN_AQUI
MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=

# Opção 2: Ollama Local (100% gratuito e local, sem API key)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3

# Opção 3: Groq / Claude / OpenRouter / DeepSeek (Exemplo OpenRouter)
# OPENAI_API_KEY=sk-or-v1-SEU_TOKEN_AQUI
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=deepseek/deepseek-chat

PORT=5000
